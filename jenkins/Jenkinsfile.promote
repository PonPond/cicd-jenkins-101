// Promote ขึ้น production แบบตั้งใจ — Jenkins deploy production เป็น Docker container (ไม่ใช้ k8s)
//
// ด่านอนุมัติโดยบุคคล = `input` step — pipeline จะหยุดรอจนกว่าจะมีคนกด Promote
// ใช้ docker socket deploy ตรง (ไม่ต้องมี kubeconfig / cluster)

pipeline {
  agent any

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '',
           description: 'image tag ที่ผ่าน staging แล้ว เช่น sha-abc1234')
  }

  options {
    timestamps()
    timeout(time: 1, unit: 'HOURS')
  }

  environment {
    IMAGE = 'ghcr.io/ponpond/cicd-jenkins-101'
  }

  stages {
    stage('Validate') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'ต้องระบุ IMAGE_TAG (เช่น sha-abc1234)'
          }
        }
      }
    }

    // ด่านอนุมัติโดยบุคคล
    stage('Approval') {
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: "Promote ${IMAGE}:${params.IMAGE_TAG} ขึ้น production?", ok: 'Promote'
        }
      }
    }

    stage('Deploy to production') {
      steps {
        sh '''
          set -e
          export APP_IMAGE=${IMAGE}:${IMAGE_TAG} APP_ENV=production HOST_PORT=3002
          docker compose -p cicd-jenkins-101-production -f deploy/docker-compose.yml up -d

          net="cicd-jenkins-101-production"
          ok=false
          for i in $(seq 1 20); do
            if docker run --rm --network "$net" curlimages/curl:8.11.1 \
                 -fsS http://app:3000/healthz >/dev/null 2>&1; then ok=true; break; fi
            sleep 1
          done
          [ "$ok" = true ] || { echo "health check ไม่ผ่าน"; \
            docker compose -p cicd-jenkins-101-production -f deploy/docker-compose.yml logs; exit 1; }
          echo "production healthy (host port 3002)"
        '''
      }
    }
  }

  post {
    success { echo "deploy production -> ${IMAGE}:${params.IMAGE_TAG} สำเร็จ (container, port 3002)" }
  }
}
