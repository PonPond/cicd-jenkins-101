// Promote ขึ้น production แบบตั้งใจ — Jenkins deploy production เองด้วย kubectl (push-based)
//
// ด่านอนุมัติโดยบุคคล = `input` step — pipeline จะหยุดรอจนกว่าจะมีคนกด Promote
//
// ต้องมี credential:
//   - kubeconfig : Secret file = kubeconfig ของ cluster ปลายทาง

pipeline {
  agent any

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '',
           description: 'image tag ที่ผ่าน staging แล้ว เช่น sha-abc1234')
  }

  options {
    timestamps()
    timeout(time: 1, unit: 'HOURS')
  }

  environment {
    IMAGE = 'ghcr.io/ponpond/cicd-jenkins-101'
  }

  stages {
    stage('Validate') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'ต้องระบุ IMAGE_TAG (เช่น sha-abc1234)'
          }
        }
      }
    }

    // ด่านอนุมัติโดยบุคคล
    stage('Approval') {
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: "Promote ${IMAGE}:${params.IMAGE_TAG} ขึ้น production?", ok: 'Promote'
        }
      }
    }

    stage('Deploy to production') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            set -e
            ( cd k8s/overlays/production && kustomize edit set image app=${IMAGE}:${IMAGE_TAG} )
            kubectl create namespace demo-production --dry-run=client -o yaml | kubectl apply -f -
            kustomize build k8s/overlays/production | kubectl apply -f -
            kubectl -n demo-production rollout status deploy/cicd-jenkins-101-production --timeout=180s
          '''
        }
      }
    }
  }

  post {
    success { echo "deploy production -> ${IMAGE}:${params.IMAGE_TAG} สำเร็จ (namespace demo-production)" }
  }
}
