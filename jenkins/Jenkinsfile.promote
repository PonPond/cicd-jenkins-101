// Promote ขึ้น production แบบตั้งใจ (เทียบเท่า .github/workflows/promote-prod.yaml)
//
// ด่านอนุมัติโดยบุคคล = `input` step (คู่ขนานกับ GitHub Environment required reviewers)
// production ฝั่ง ArgoCD ตั้งเป็น manual-sync จึงต้องไปกด Sync ใน ArgoCD อีกครั้งหลัง commit

pipeline {
  agent any

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '',
           description: 'image tag ที่ผ่าน staging แล้ว เช่น sha-abc1234')
  }

  options {
    timestamps()
    timeout(time: 1, unit: 'HOURS')   // รอการอนุมัติได้สูงสุด 1 ชม.
  }

  environment {
    IMAGE    = 'ghcr.io/ponpond/cicd-gitops-jenkins-101'
    REPO_URL = 'github.com/ponpond/cicd-gitops-jenkins-101.git'
  }

  stages {
    stage('Validate') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'ต้องระบุ IMAGE_TAG (เช่น sha-abc1234)'
          }
        }
      }
    }

    // ด่านอนุมัติโดยบุคคล — pipeline จะหยุดรอจนกว่าจะมีคนกด Promote
    stage('Approval') {
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: "Promote ${IMAGE}:${params.IMAGE_TAG} ขึ้น production?", ok: 'Promote'
        }
      }
    }

    stage('Bump production overlay') {
      steps {
        sh 'cd gitops/overlays/production && kustomize edit set image app=${IMAGE}:${IMAGE_TAG}'
        withCredentials([usernamePassword(credentialsId: 'github-pat',
                         usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh '''
            set -e
            git config user.name  "jenkins-bot"
            git config user.email "jenkins-bot@users.noreply.github.com"
            git add gitops/overlays/production/kustomization.yaml
            git commit -m "chore(deploy): production -> ${IMAGE_TAG}"
            git push "https://${GH_USER}:${GH_TOKEN}@${REPO_URL}" HEAD:main
          '''
        }
      }
    }
  }

  post {
    success {
      echo "bump production -> ${IMAGE}:${params.IMAGE_TAG} แล้ว — ไปกด Sync ใน ArgoCD (production = manual-sync)"
    }
  }
}
