# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# (ไฟล์ .env ถูก gitignore ไว้ — อย่า commit ค่าจริง)

# --- บัญชีแอดมิน ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=เปลี่ยนเป็นรหัสที่แข็งแรง

# --- URL ที่เข้าถึง Jenkins (ใส่โดเมน/ไอพีเซิร์ฟเวอร์จริง) ---
JENKINS_URL=http://your-server:8080/

# --- ที่อยู่ข้อมูล Jenkins บน host (bind mount — ลบ volume แล้วไม่หาย) ---
# จะใช้ path สัมบูรณ์บนเซิร์ฟเวอร์ก็ได้ เช่น /srv/jenkins/jenkins_home
JENKINS_HOME_DIR=./data/jenkins_home

# --- พอร์ต ---
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000

# --- timezone ---
TZ=Asia/Bangkok

# --- GitHub (ไม่บังคับ; ใช้ seed credential github-pat) ---
GITHUB_USER=your-github-username
GH_TOKEN=ghp_xxxxxxxxxxxxxxxx
